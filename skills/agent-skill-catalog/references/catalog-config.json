    "video": {"label": "视频与动效", "keywords": ["video", "film", "motion", "animation", "ffmpeg", "caption", "b-roll", "storyboard", "视频", "影片", "动效", "动画", "字幕", "分镜", "镜头"]},
    "audio": {"label": "音频与配音", "keywords": ["audio", "voice", "speech", "tts", "podcast", "music", "sound", "narration", "音频", "语音", "配音", "播客", "音乐", "声音", "旁白"]},
    "content": {"label": "内容与增长", "keywords": ["content", "writing", "copywriting", "social", "seo", "marketing", "brand", "内容", "写作", "文案", "社交", "营销", "品牌", "增长"]},
