{
  "config_version": "1.1",
  "locale": "zh-CN",
  "roots": [],
  "output_dir": "agent-skill-catalog-output",
  "include_absolute_paths": false,
  "scan": {
    "skip_dirs": [".git", ".venv", "venv", "node_modules", "__pycache__", "tests", "test", "fixtures", "examples", "vendor", "site-packages", ".previews"],
    "max_depth": 12
  },
  "image": {
    "frontmatter_keys": ["preview_image", "image", "cover", "preview"],
    "sidecar_names": ["preview.png", "preview.jpg", "preview.jpeg", "preview.webp", "cover.png", "cover.jpg", "cover.webp", "assets/preview.png", "assets/preview.jpg", "assets/preview.webp"],
    "allow_remote_metadata": true,
    "category_cover_fallback": true,
    "github_repository_previews": true,
    "github_image_cache_ttl_hours": 168,
    "github_request_timeout_seconds": 6,
    "github_max_page_bytes": 1048576,
    "github_max_download_bytes": 2097152,
    "github_image_candidate_limit": 3,
    "github_fetch_workers": 8,
    "max_embedded_bytes": 524288
  },
  "classification": {
    "small_margin": 1.0,
    "low_confidence": 0.5
  },
  "category_tie_break": ["internet_search", "securities", "learning", "video", "audio", "content", "data", "development", "productivity", "specialist", "visual", "other"],
  "category_overrides": {},
  "curation": {
    "description_overrides": {},
    "github_overrides": {},
    "family_overrides": {},
    "image_overrides": {}
  },
