{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skill-catalog/catalog.schema.json",
  "title": "Portable Agent Skill Catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "roots", "items", "families", "plugins", "categories", "category_coverage", "summary"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "generated_at": {"type": "string"},
    "mode": {"enum": ["initial", "refresh"]},
    "roots": {"type": "array", "items": {"type": "object", "required": ["path", "label", "kind"]}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "families": {"type": "array", "items": {"$ref": "#/$defs/aggregate"}},
    "plugins": {"type": "array", "items": {"type": "object"}},
    "categories": {"type": "object"},
    "category_coverage": {"$ref": "category-coverage.schema.json"},
    "summary": {"type": "object", "required": ["skill_count", "plugin_count", "family_count", "category_count"]}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "name", "description", "description_source", "category", "category_evidence", "confidence", "source", "relative_path", "invocation", "image"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "description_source": {"enum": ["source", "curation"]},
        "source_description": {"type": "string"},
        "category": {"type": "string"},
        "category_evidence": {"type": "array"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"type": "string"},
        "kind": {"enum": ["skill", "plugin"]},
        "relative_path": {"type": "string"},
        "path": {"type": "string"},
        "image": {"type": "object", "required": ["status", "source"]}
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["id", "name", "category", "description", "image", "invocation", "skill_ids"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"},
        "image": {"type": "object"},
        "invocation": {"type": "string"},
        "skill_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
